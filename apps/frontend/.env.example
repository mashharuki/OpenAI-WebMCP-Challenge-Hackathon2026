# Omit for same-origin deployments (and local Vite proxy usage).
# Set this to the deployed resource-server origin when frontend and API differ.
VITE_API_BASE_URL=https://api.example.com

# Public WebMCP Origin Trial token issued for the final frontend origin.
VITE_ORIGIN_TRIAL_TOKEN=

# Full git commit SHA used for this build. This value is public provenance.
VITE_RELEASE_SHA=
