{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "adgate-resource-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["ALLOWED_ORIGINS", "EVM_ADDRESS", "FACILITATOR_URL"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "API_COORDINATOR",
        "class_name": "ApiCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiCoordinator"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
